# ---------------------------------------------------------------------------
# Supabase (from your project's Settings -> API)
# ---------------------------------------------------------------------------
# Public URL of your Supabase project. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Public anon key. Safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key. SERVER ONLY. Never expose to the browser. Used by the
# cron route to write recurring transactions bypassing a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Google Gemini (Vision OCR) - https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Model id used by /api/ocr. Flash tier is cheapest + vision capable.
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Cron - shared secret that /api/cron/check-recurring checks in the
# `x-cron-secret` header. Generate a long random string.
# ---------------------------------------------------------------------------
CRON_SECRET=change-me-to-a-long-random-string
